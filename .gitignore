# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw purchased design files and conversions (not published)
/design-assets/

# Client chat exports (contain bank details, phone numbers and shared credentials)
/chat/

# Scrape archives, GSC exports and other working data (large, client-owned, re-creatable)
/data/

# Sanity Studio build output
/studio/dist
/studio/.sanity
/studio/schema-extract.json

# Not part of the running site: working material that stays on the developer's computer and is not pushed.
# Project plan, reports, client documents and Word files
/docs/
# Design pictures the client sent
/references/
# Scraped content of the old sites (the source of `npm run sanity:import`; the site reads Sanity, not these files)
/content/scraped/
# One-off tools: scraping, stock pictures, QA crawls, review exports, icon and image builders, site checks
/scripts/scrape/
/scripts/depositphotos/
/scripts/qa/
/scripts/i18n/
/scripts/audit-seo.mjs
/scripts/build-favicon.mjs
/scripts/build-ornaments.mjs
/scripts/check-site.mjs
/scripts/eps-to-svg.mjs
/scripts/fetch-images.mjs
# Word lock files
~$*
