# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw purchased design files and conversions (not published)
/design-assets/

# Client chat exports (contain bank details, phone numbers and shared credentials)
/chat/

# Scrape archives, GSC exports and other working data (large, client-owned, re-creatable)
/data/

# Sanity Studio build output
/studio/dist
/studio/.sanity
