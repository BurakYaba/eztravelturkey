# Copy to .env.local and fill in what you need. Nothing here is required to run the site.

# Public site address, used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.magnificenttravel.com

# Shown in the footer and on the contact page when set. The live site hides its address behind an obfuscator,
# so no email is shown until you add one here.
NEXT_PUBLIC_CONTACT_EMAIL=

# Email delivery for the trip request, contact and newsletter forms (https://resend.com).
# Without all three, the forms still work: visitors get a WhatsApp message prefilled with their request.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Cloudflare Turnstile, the spam check on the enquiry forms (dash.cloudflare.com > Turnstile > add a widget for the
# site's domain). The site key is public, the secret key stays on the server. Without them the forms use only a hidden
# trap field. For local tests Cloudflare publishes keys that always pass: site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only used by `npm run images` to download destination photos from Pexels. Never sent to the browser.
PEXELS_API_KEY=

# Sanity, where all tours, pages and blog posts live. The datasets are public, so reading needs no token. Both values
# below are the defaults; set them only to read a different project or dataset (for example staging).
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only for `npm run sanity:import` (writes content and pictures): a token with the Editor role from
# sanity.io/manage > project > API > Tokens. Never commit it, never set it on Vercel.
SANITY_WRITE_TOKEN=

# Shared secret of the Sanity webhook that calls /api/revalidate when something is published. The webhook sends it in the
# `x-revalidate-secret` header. Set the same value on Vercel.
SANITY_REVALIDATE_SECRET=

# Preview of unpublished changes (Studio > Presentation). A token with the Viewer role from sanity.io/manage > project > API >
# Tokens; set it on Vercel (Production and Preview). Without it the preview link answers "not set up". Server only.
SANITY_PREVIEW_TOKEN=

# Deploy Hook of the Vercel project (Settings > Git > Deploy Hooks, branch main). When an editor changes the old addresses of a
# blog post, the revalidate webhook calls it so the new redirects go live without a developer. Optional.
VERCEL_DEPLOY_HOOK_URL=

# Backup and clean-up of the Sanity content run in GitHub Actions and use repository secrets with these names, not this file:
# SANITY_BACKUP_TOKEN (Viewer), SANITY_CLEANUP_TOKEN (Editor). For a local run scripts/sanity/backup.mjs and
# orphan-assets.mjs fall back to SANITY_WRITE_TOKEN.

# Google Tag Manager container (P8.5). Leave empty in previews and local copies: nothing is sent to Google Analytics then.
# Production: GTM-55HWFMHR (the live English site's container, reused so the history continues).
NEXT_PUBLIC_GTM_ID=

# IndexNow key (P8.6): 32 random hex characters. The same value is served at /<key>.txt and used by scripts/indexnow-submit.mjs.
INDEXNOW_KEY=
